import sqlite3
from contextlib import closing
from pathlib import Path

DB_FILE = Path(__file__).resolve().parent.parent / "data" / "gulf_marine.db"
DB_FILE.parent.mkdir(parents=True, exist_ok=True)


def get_connection():
    conn = sqlite3.connect(DB_FILE)
    conn.row_factory = sqlite3.Row
    return conn


def init_db():
    with closing(get_connection()) as conn:
        conn.execute(
            """
            CREATE TABLE IF NOT EXISTS trucks (
                id INTEGER PRIMARY KEY AUTOINCREMENT,
                name TEXT UNIQUE NOT NULL,
                plate_number TEXT NOT NULL,
                driver_name TEXT,
                status TEXT DEFAULT 'IN_TRANSIT',
                last_latitude REAL,
                last_longitude REAL,
                last_geofence TEXT,
                last_updated TEXT DEFAULT CURRENT_TIMESTAMP,
                manager_email TEXT
            )
            """
        )

        conn.execute(
            """
            CREATE TABLE IF NOT EXISTS geofences (
                id INTEGER PRIMARY KEY AUTOINCREMENT,
                name TEXT UNIQUE NOT NULL,
                latitude REAL NOT NULL,
                longitude REAL NOT NULL,
                radius_meters REAL NOT NULL DEFAULT 200.0,
                created_at TEXT DEFAULT CURRENT_TIMESTAMP
            )
            """
        )

        conn.execute(
            """
            CREATE TABLE IF NOT EXISTS alerts (
                id INTEGER PRIMARY KEY AUTOINCREMENT,
                truck_id INTEGER NOT NULL,
                truck_name TEXT NOT NULL,
                alert_type TEXT NOT NULL,
                message TEXT NOT NULL,
                latitude REAL,
                longitude REAL,
                created_at TEXT DEFAULT CURRENT_TIMESTAMP
            )
            """
        )

        conn.commit()


def create_truck(name: str, plate_number: str, driver_name: str, manager_email: str | None = None):
    with closing(get_connection()) as conn:
        cursor = conn.execute(
            """
            INSERT INTO trucks (name, plate_number, driver_name, manager_email)
            VALUES (?, ?, ?, ?)
            """,
            (name, plate_number, driver_name, manager_email),
        )
        conn.commit()
        return get_truck(cursor.lastrowid)


def get_truck(truck_id: int):
    with closing(get_connection()) as conn:
        row = conn.execute("SELECT * FROM trucks WHERE id = ?", (truck_id,)).fetchone()
        return dict(row) if row else None


def list_trucks():
    with closing(get_connection()) as conn:
        rows = conn.execute(
            "SELECT * FROM trucks ORDER BY last_updated DESC"
        ).fetchall()
        return [dict(row) for row in rows]


def create_geofence(name: str, latitude: float, longitude: float, radius_meters: float = 200.0):
    with closing(get_connection()) as conn:
        cursor = conn.execute(
            """
            INSERT INTO geofences (name, latitude, longitude, radius_meters)
            VALUES (?, ?, ?, ?)
            """,
            (name, latitude, longitude, radius_meters),
        )
        conn.commit()
        return {
            "id": cursor.lastrowid,
            "name": name,
            "latitude": latitude,
            "longitude": longitude,
            "radius_meters": radius_meters,
        }


def list_geofences():
    with closing(get_connection()) as conn:
        rows = conn.execute("SELECT * FROM geofences ORDER BY name").fetchall()
        return [dict(row) for row in rows]


def create_alert(truck_id: int, truck_name: str, alert_type: str, message: str, latitude: float | None = None, longitude: float | None = None):
    with closing(get_connection()) as conn:
        conn.execute(
            """
            INSERT INTO alerts (truck_id, truck_name, alert_type, message, latitude, longitude)
            VALUES (?, ?, ?, ?, ?, ?)
            """,
            (truck_id, truck_name, alert_type, message, latitude, longitude),
        )
        conn.commit()
        return {
            "truck_id": truck_id,
            "truck_name": truck_name,
            "alert_type": alert_type,
            "message": message,
            "latitude": latitude,
            "longitude": longitude,
        }


def list_alerts(limit: int = 50):
    with closing(get_connection()) as conn:
        rows = conn.execute(
            "SELECT * FROM alerts ORDER BY created_at DESC LIMIT ?",
            (limit,),
        ).fetchall()
        return [dict(row) for row in rows]


def update_truck_location(truck_id: int, latitude: float, longitude: float, status: str, last_geofence: str | None):
    with closing(get_connection()) as conn:
        conn.execute(
            """
            UPDATE trucks
            SET last_latitude = ?,
                last_longitude = ?,
                status = ?,
                last_geofence = ?,
                last_updated = CURRENT_TIMESTAMP
            WHERE id = ?
            """,
            (latitude, longitude, status, last_geofence, truck_id),
        )
        conn.commit()
        return get_truck(truck_id)
